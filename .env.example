# Required for live runs (omit entirely for `npm run probe:dry`)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# Where this sweep is running from. Shows up in the public methodology page,
# so use something honest and short: blr, iad, fra, sin.
PROBE_REGION=local

# Inference probes activate per provider, only when a key is present.
# No key means the edge probe still runs. This is how it stays free.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
